<!--
  Include this fragment in the inbound section of a protected API or product.

  Required named values:
  - approov-validation-function-url:
      https://<function-app>.azurewebsites.net/api/approov/verify
  - approov-validation-function-audience:
      Microsoft Entra application ID URI or resource configured for the Function App auth.
-->
<fragment>
  <choose>
    <when condition="@(context.Request.Method == &quot;OPTIONS&quot;)">
      <!-- CORS preflight is intentionally bypassed for v1. -->
    </when>
    <otherwise>
      <send-request mode="copy" response-variable-name="approovValidationResponse" timeout="10" ignore-error="true">
        <set-url>{{approov-validation-function-url}}</set-url>
        <set-header name="X-Approov-Original-Method" exists-action="override">
          <value>@(context.Request.Method)</value>
        </set-header>
        <set-header name="X-Approov-Original-Scheme" exists-action="override">
          <value>@(context.Request.OriginalUrl.Scheme)</value>
        </set-header>
        <set-header name="X-Approov-Original-Host" exists-action="override">
          <value>@(context.Request.OriginalUrl.Host)</value>
        </set-header>
        <set-header name="X-Approov-Original-Path" exists-action="override">
          <value>@(context.Request.OriginalUrl.Path)</value>
        </set-header>
        <set-header name="X-Approov-Original-Query" exists-action="override">
          <value>@(context.Request.OriginalUrl.QueryString)</value>
        </set-header>
        <set-header name="X-Approov-Original-Url" exists-action="override">
          <value>@(context.Request.OriginalUrl.Scheme + &quot;://&quot; + context.Request.OriginalUrl.Host + context.Request.OriginalUrl.Path + context.Request.OriginalUrl.QueryString)</value>
        </set-header>
        <authentication-managed-identity resource="{{approov-validation-function-audience}}" />
      </send-request>

      <choose>
        <when condition="@(!context.Variables.ContainsKey(&quot;approovValidationResponse&quot;) || context.Variables[&quot;approovValidationResponse&quot;] == null || ((IResponse)context.Variables[&quot;approovValidationResponse&quot;]).StatusCode != 200)">
          <return-response>
            <set-status code="401" reason="Unauthorized" />
            <set-header name="Content-Type" exists-action="override">
              <value>application/json</value>
            </set-header>
            <set-body>{"error":"approov_validation_failed"}</set-body>
          </return-response>
        </when>
      </choose>

      <set-header name="X-Approov-Verified" exists-action="override">
        <value>true</value>
      </set-header>
      <set-header name="X-Approov-Device-Id" exists-action="override">
        <value>@(((IResponse)context.Variables[&quot;approovValidationResponse&quot;]).Headers.GetValueOrDefault(&quot;X-Approov-Device-Id&quot;, &quot;&quot;))</value>
      </set-header>
      <set-header name="X-Approov-Token-Expiry" exists-action="override">
        <value>@(((IResponse)context.Variables[&quot;approovValidationResponse&quot;]).Headers.GetValueOrDefault(&quot;X-Approov-Token-Expiry&quot;, &quot;&quot;))</value>
      </set-header>
    </otherwise>
  </choose>

  <set-header name="Approov-Token" exists-action="delete" />
  <set-header name="Signature" exists-action="delete" />
  <set-header name="Signature-Input" exists-action="delete" />
  <set-header name="Content-Digest" exists-action="delete" />
  <set-header name="X-Approov-Original-Method" exists-action="delete" />
  <set-header name="X-Approov-Original-Scheme" exists-action="delete" />
  <set-header name="X-Approov-Original-Host" exists-action="delete" />
  <set-header name="X-Approov-Original-Path" exists-action="delete" />
  <set-header name="X-Approov-Original-Query" exists-action="delete" />
  <set-header name="X-Approov-Original-Url" exists-action="delete" />
</fragment>
